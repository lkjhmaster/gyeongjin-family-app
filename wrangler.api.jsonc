{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gyeongjin-family-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gyeongjin-family-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
